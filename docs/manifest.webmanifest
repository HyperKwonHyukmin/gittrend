{
  "name": "GitTrend",
  "short_name": "GitTrend",
  "description": "GitHub에서 요즘 주목받는 라이브러리 모음",
  "start_url": "./#/t/hot",
  "display": "standalone",
  "background_color": "#f6f4ef",
  "theme_color": "#d9822b",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
