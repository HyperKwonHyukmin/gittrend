# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# gpt-5 계열의 추론 강도 (minimal / low / medium). 요약에는 low면 충분합니다
OPENAI_REASONING=low
# 선택: 있으면 저장소 상세 정보와 star 추적이 풍부해집니다 (github.com/settings/tokens, 권한 없이 발급)
GITHUB_TOKEN=
# 한 번 실행에 새로 정리할 최대 개수. 한 번 정리한 저장소는 다시 정리하지 않습니다
MAX_SUMMARIES=60

# ----- AI 뉴스 (선택) -----
# 네이버 검색 API: developers.naver.com → Application 등록 → 검색 API 선택 후 받은 값
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Threads API 키워드 검색용 액세스 토큰 (60일마다 갱신 필요)
THREADS_ACCESS_TOKEN=
# 한 번 실행에 AI로 정리할 새 기사 최대 수. 한 번 정리한 기사는 다시 보내지 않습니다
MAX_NEWS_AI=160
