# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env는 git에 올라가지 않습니다)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# 추론 강도 (low / medium / high)
ANTHROPIC_EFFORT=medium
# ----- 심층 분석 (주요 API, 동작 원리, 사용 방식, 내 작업 적합도) -----
# 더 많은 자료를 더 깊게 읽는다. 한 번 분석한 라이브러리는 다시 분석하지 않는다
ANTHROPIC_DEEP_MODEL=claude-opus-5-5
ANTHROPIC_DEEP_EFFORT=high
# 실행마다 종합 주목 상위에서 자동으로 분석할 개수 (0이면 자동 분석 끔, 요청 버튼만 사용)
DEEP_PER_RUN=1
# 선택: 있으면 저장소 상세 정보와 star 추적이 풍부해집니다 (github.com/settings/tokens, 권한 없이 발급)
GITHUB_TOKEN=
# 한 번 실행에 새로 정리할 최대 개수. 한 번 정리한 저장소는 다시 정리하지 않습니다
MAX_SUMMARIES=60

# ----- AI 레이더 (새 모델 · 도구 · 사용법) -----
# 한 번 실행에 AI로 판단할 새 항목 최대 수. 한 번 판단한 항목은 다시 보내지 않습니다
MAX_NEWS_AI=160
# 한 번 실행에 만들 카드(원문을 읽고 정리한 상세 내용) 최대 수. 0이면 카드 안 만듦
MAX_NEWS_CARDS=30
# 선택: 국내 블로그 사용기 수집 (카카오 블로그 검색). 비우면 이 출처만 건너뜁니다
# developers.kakao.com → 내 애플리케이션 → 앱 키의 REST API 키
KAKAO_REST_API_KEY=
